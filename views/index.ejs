<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Autodarts Leaderboard</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="hero">
    <div>
      <p class="eyebrow">Autodarts Turnierserie</p>
      <h1>Leaderboard & Spielplan</h1>
      <p class="lead">Öffentliche Tabelle für alle Teilnehmer. Ergebnisse und Paarungen werden im Adminbereich gepflegt.</p>
    </div>
    <nav>
      <% if (isAuthenticated) { %>
        <a class="button secondary" href="/admin">Adminbereich</a>
      <% } else { %>
        <a class="button secondary" href="/admin/login">Admin-Login</a>
      <% } %>
    </nav>
  </header>

  <main class="grid two-col">
    <section class="card">
      <div class="card-header">
        <h2>Tabelle</h2>
        <span><%= standings.length %> aktive Spieler</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Spieler</th>
              <th>Sp</th>
              <th>S</th>
              <th>N</th>
              <th>Legs</th>
              <th>Diff</th>
              <th>Pkte</th>
            </tr>
          </thead>
          <tbody>
            <% if (!standings.length) { %>
              <tr><td colspan="8" class="muted">Noch keine Spieler angelegt.</td></tr>
            <% } %>
            <% standings.forEach((row) => { %>
              <tr>
                <td><%= row.rank %></td>
                <td><strong><%= row.name %></strong></td>
                <td><%= row.played %></td>
                <td><%= row.wins %></td>
                <td><%= row.losses %></td>
                <td><%= row.legsFor %>:<%= row.legsAgainst %></td>
                <td><%= row.legDiff %></td>
                <td><strong><%= row.points %></strong></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2>Spielplan</h2>
        <span><%= totalMatches %> Spiele insgesamt</span>
      </div>

      <form method="get" action="/" class="filter-form">
        <label>
          Spielwoche
          <select name="week">
            <option value="all" <%= filters.week === 'all' ? 'selected' : '' %>>Alle Wochen</option>
            <% matchWeeks.forEach((week) => { %>
              <option value="<%= week %>" <%= filters.week === week ? 'selected' : '' %>>Woche <%= week %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Status
          <select name="status">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Alle Status</option>
            <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Offene Spiele</option>
            <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>>Geplant</option>
            <option value="played" <%= filters.status === 'played' ? 'selected' : '' %>>Gespielt</option>
            <option value="postponed" <%= filters.status === 'postponed' ? 'selected' : '' %>>Verschoben</option>
          </select>
        </label>
        <label>
          Spieler
          <select name="player">
            <option value="all" <%= filters.player === 'all' ? 'selected' : '' %>>Alle Spieler</option>
            <% players.forEach((player) => { %>
              <option value="<%= player.id %>" <%= filters.player === player.id ? 'selected' : '' %>><%= player.name %></option>
            <% }) %>
          </select>
        </label>
        <div class="filter-actions">
          <button class="button" type="submit">Filtern</button>
          <a class="button secondary" href="/?week=all&amp;status=all&amp;player=all">Alle anzeigen</a>
        </div>
      </form>

      <p class="filter-summary"><strong><%= matches.length %></strong> von <%= totalMatches %> Spielen werden angezeigt.</p>

      <div class="match-list public-match-list">
        <% if (!matches.length) { %>
          <p class="empty-state">Für diese Filter wurden keine Spiele gefunden.</p>
        <% } %>
        <% matches.forEach((match) => { %>
          <details class="match-item compact-match-item">
            <summary class="compact-match-summary">
              <span class="matchup">
                <strong class="player-name"><%= match.home_name %></strong>
                <span class="compact-score">
                  <%= match.status === 'played' && match.home_legs != null && match.away_legs != null ? `${match.home_legs} : ${match.away_legs}` : '–' %>
                </span>
                <strong class="player-name away-player"><%= match.away_name %></strong>
              </span>
              <% if (match.status === 'postponed') { %>
                <span class="badge postponed">verschoben</span>
              <% } %>
              <span class="info-trigger" aria-hidden="true">i</span>
              <span class="sr-only">Details zu <%= match.home_name %> gegen <%= match.away_name %></span>
            </summary>
            <div class="match-details">
              <dl>
                <div><dt>Spielwoche</dt><dd>Woche <%= match.week %></dd></div>
                <div>
                  <dt>Status</dt>
                  <dd><%= match.status === 'played' ? 'Gespielt' : match.status === 'postponed' ? 'Verschoben' : 'Geplant' %></dd>
                </div>
                <% if (match.scheduled_date) { %>
                  <div><dt>Geplanter Termin</dt><dd><%= match.scheduled_date %></dd></div>
                <% } %>
                <% if (match.played_at) { %>
                  <div><dt>Gespielt am</dt><dd><%= match.played_at %></dd></div>
                <% } %>
              </dl>
              <% if (match.note) { %>
                <p class="muted match-note"><%= match.note %></p>
              <% } %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>
  </main>
</body>
</html>
