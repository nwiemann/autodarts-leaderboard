<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Autodarts Leaderboard</title>
  <link rel="stylesheet" href="/styles.css" />
</head>
<body>
  <header class="hero">
    <div>
      <p class="eyebrow">Autodarts Turnierserie</p>
      <h1>Leaderboard & Spielplan</h1>
      <p class="lead">Öffentliche Tabelle für alle Teilnehmer. Ergebnisse und Paarungen werden im Adminbereich gepflegt.</p>
    </div>
    <nav>
      <% if (isAuthenticated) { %>
        <a class="button secondary" href="/admin">Adminbereich</a>
      <% } else { %>
        <a class="button secondary" href="/admin/login">Admin-Login</a>
      <% } %>
    </nav>
  </header>

  <main class="grid two-col">
    <section class="card">
      <div class="card-header">
        <h2>Tabelle</h2>
        <span><%= standings.length %> aktive Spieler</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Spieler</th>
              <th>Sp</th>
              <th>S</th>
              <th>N</th>
              <th>Legs</th>
              <th>Diff</th>
              <th>Pkte</th>
            </tr>
          </thead>
          <tbody>
            <% if (!standings.length) { %>
              <tr><td colspan="8" class="muted">Noch keine Spieler angelegt.</td></tr>
            <% } %>
            <% standings.forEach((row) => { %>
              <tr>
                <td><%= row.rank %></td>
                <td><strong><%= row.name %></strong></td>
                <td><%= row.played %></td>
                <td><%= row.wins %></td>
                <td><%= row.losses %></td>
                <td><%= row.legsFor %>:<%= row.legsAgainst %></td>
                <td><%= row.legDiff %></td>
                <td><strong><%= row.points %></strong></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="card">
      <div class="card-header">
        <h2>Spielplan</h2>
        <span><%= totalMatches %> Spiele insgesamt</span>
      </div>

      <form method="get" action="/" class="filter-form">
        <label>
          Spielwoche
          <select name="week">
            <option value="all">Alle Wochen</option>
            <% matchWeeks.forEach((week) => { %>
              <option value="<%= week %>" <%= filters.week === week ? 'selected' : '' %>>Woche <%= week %></option>
            <% }) %>
          </select>
        </label>
        <label>
          Status
          <select name="status">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>Alle Status</option>
            <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Offene Spiele</option>
            <option value="scheduled" <%= filters.status === 'scheduled' ? 'selected' : '' %>>Geplant</option>
            <option value="played" <%= filters.status === 'played' ? 'selected' : '' %>>Gespielt</option>
            <option value="postponed" <%= filters.status === 'postponed' ? 'selected' : '' %>>Verschoben</option>
          </select>
        </label>
        <label>
          Spieler
          <select name="player">
            <option value="all">Alle Spieler</option>
            <% players.forEach((player) => { %>
              <option value="<%= player.id %>" <%= filters.player === player.id ? 'selected' : '' %>><%= player.name %></option>
            <% }) %>
          </select>
        </label>
        <div class="filter-actions">
          <button class="button" type="submit">Filtern</button>
          <a class="button secondary" href="/">Zurücksetzen</a>
        </div>
      </form>

      <p class="filter-summary"><strong><%= matches.length %></strong> von <%= totalMatches %> Spielen werden angezeigt.</p>

      <div class="match-week-list">
        <% if (!matches.length) { %>
          <p class="empty-state">Für diese Filter wurden keine Spiele gefunden.</p>
        <% } %>
        <% matchGroups.forEach((group) => { %>
          <details class="week-group" <%= group.week === openWeek ? 'open' : '' %>>
            <summary>
              <span>Woche <%= group.week %></span>
              <span class="week-count"><%= group.matches.length %> <%= group.matches.length === 1 ? 'Spiel' : 'Spiele' %></span>
            </summary>
            <div class="match-list">
              <% group.matches.forEach((match) => { %>
                <article class="match-item">
                  <div class="match-topline">
                    <span class="badge <%= match.status %>">
                      <%= match.status === 'played' ? 'gespielt' : match.status === 'postponed' ? 'verschoben' : 'geplant' %>
                    </span>
                  </div>
                  <h3><%= match.home_name %> vs. <%= match.away_name %></h3>
                  <% if (match.status === 'played') { %>
                    <p class="score"><strong><%= match.home_legs %> : <%= match.away_legs %></strong></p>
                  <% } %>
                  <p class="meta">
                    <% if (match.scheduled_date) { %>Termin: <%= match.scheduled_date %><% } %>
                    <% if (match.played_at) { %> · Gespielt: <%= match.played_at %><% } %>
                  </p>
                  <% if (match.note) { %>
                    <p class="muted"><%= match.note %></p>
                  <% } %>
                </article>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>
  </main>
</body>
</html>
